clear
new circuit.split bus1=source basekv=12.47 pu=1 phases=3 r1=.01 x1=.03 r0=.02 x0=.06
new transformer.bank phases=1 windings=3 buses=[source.3 secondary.1.0 secondary.0.2] conns=[wye wye wye] kvs=[7.199557856794634 0.12 0.12] kvas=[100 50 50] %rs=[.5 .5 .5] xhl=2 xht=2 xlt=1.2 taps=[1 1 1] ppm_antifloat=0
new load.leg1 phases=1 bus1=secondary.1 conn=wye kv=.12 kw=15 kvar=5 vminpu=0 vmaxpu=1000000
new load.leg2 phases=1 bus1=secondary.2 conn=wye kv=.12 kw=15 kvar=5 vminpu=0 vmaxpu=1000000
set maxiterations=200 tolerance=1e-10
solve
