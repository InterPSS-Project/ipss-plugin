clear
new circuit.cable_ts bus1=source basekv=12.47 pu=1 phases=3 r1=.01 x1=.03 r0=.02 x0=.06
set earthmodel=carson
new tsdata.wire0 rac=.0002 rdc=.00019 runits=m gmrac=.006 gmrunits=m radius=.008 radunits=m epsr=2.3 inslayer=.005 diains=.026 diacable=.032 diashield=.0285 tapelayer=.00025 tapelap=20
new tsdata.wire1 rac=.0002 rdc=.00019 runits=m gmrac=.006 gmrunits=m radius=.008 radunits=m epsr=2.3 inslayer=.005 diains=.026 diacable=.032 diashield=.0285 tapelayer=.00025 tapelap=20
new tsdata.wire2 rac=.0002 rdc=.00019 runits=m gmrac=.006 gmrunits=m radius=.008 radunits=m epsr=2.3 inslayer=.005 diains=.026 diacable=.032 diashield=.0285 tapelayer=.00025 tapelap=20
new linegeometry.cable nconds=3 nphases=3 reduce=yes
~ cond=1 tscable=wire0 x=0.0 h=-1 units=m
~ cond=2 tscable=wire1 x=0.15 h=-1 units=m
~ cond=3 tscable=wire2 x=0.3 h=-1 units=m
new line.cable phases=3 bus1=source.1.2.3 bus2=end.1.2.3 geometry=cable length=500 units=m
new load.loadA phases=1 bus1=end.1 conn=wye kv=7.199557856794634 kw=200 kvar=40 vminpu=0 vmaxpu=1000000
new load.loadB phases=1 bus1=end.2 conn=wye kv=7.199557856794634 kw=400 kvar=40 vminpu=0 vmaxpu=1000000
new load.loadC phases=1 bus1=end.3 conn=wye kv=7.199557856794634 kw=600 kvar=40 vminpu=0 vmaxpu=1000000
set maxiterations=200 tolerance=1e-10
solve
